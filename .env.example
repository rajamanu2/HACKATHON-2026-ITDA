# Optional server environment overrides; no .env loader is used.
# Local n8n is configured by scripts/configure-local-n8n.mjs in private SQLite settings.
PORT=4173
HOST=127.0.0.1
# Set COOKIE_SECURE=true only behind a trusted HTTPS endpoint.
# COOKIE_SECURE=true
# DATA_DIR=.local
# N8N_WEBHOOK_URL=https://your-n8n.example/webhook/drishti-events
# N8N_WEBHOOK_TOKEN=configure-privately
# N8N_CALLBACK_TOKEN=configure-privately
